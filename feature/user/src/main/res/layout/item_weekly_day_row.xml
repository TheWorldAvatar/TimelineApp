<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/day_row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="52dp"
        android:orientation="vertical"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_day_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_day_trips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_day_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_day_expand"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Expand buffer details"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Proportional Bar + Weekly Mean Marker + Delta -->
        <LinearLayout
            android:id="@+id/day_bar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/day_bar_track"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="?attr/colorSurfaceVariant">

                <View
                    android:id="@+id/day_bar_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorPrimary" />

                <View
                    android:id="@+id/day_bar_mean_tick"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:alpha="0.55"
                    android:background="?attr/colorOnSurface" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_day_delta"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
        </LinearLayout>
    </LinearLayout>

    <!-- Expandable Buffer Sensitivity Container -->
    <LinearLayout
        android:id="@+id/day_buffers_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:visibility="gone" />

    <View
        android:id="@+id/day_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.5"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>