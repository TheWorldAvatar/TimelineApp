<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timeline_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout 
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.mapbox.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:mapbox_cameraTargetLat="1.2966"
            app:mapbox_cameraTargetLng="103.7764"
            app:mapbox_cameraZoom="15.0" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            style="@style/Widget.GradientToolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/map_top_appbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:menu="@menu/timeline_menu"
                app:title="TWA Timeline"
                app:titleCentered="true"
                app:navigationIcon="@drawable/ic_menu_24"
                app:navigationIconTint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trip_detail_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/trip_detail_eyebrow_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="@string/exposure_summary_eyebrow"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/trip_detail_id_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/trip_detail_close_bt"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/trip_detail_table_header_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorSurfaceVariant"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/trip_detail_table_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="?attr/colorOutlineVariant" />
                        </LinearLayout>

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/trip_detail_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:fadeScrollbars="false"
                            android:fillViewport="false"
                            android:overScrollMode="never"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/trip_detail_distance_tv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:id="@+id/trip_detail_table_rows"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:divider="?android:attr/listDivider"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="12dp"
                                    android:showDividers="middle" />
                            </LinearLayout>
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/trip_detail_prev_bt"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_outline_button"
                        android:contentDescription="@string/previous"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_left_24"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/trip_detail_page_indicator_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/trip_detail_next_bt"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_outline_button"
                        android:contentDescription="@string/next"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurface" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bottom_sheet_container"
            style="@style/Widget.TWA.BottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            app:behavior_fitToContents="false"
            app:behavior_halfExpandedRatio="0.38"
            app:behavior_hideable="false"
            app:behavior_peekHeight="100dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/legend_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:translationY="-40dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_anchor="@id/bottom_sheet_container"
            app:layout_anchorGravity="top|start"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/legend_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/legend_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/legend_modes"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/legend_chevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/baseline_arrow_drop_down_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/legend_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/legend_line_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/legend_row_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp"
                            android:paddingEnd="10dp">

                            <View
                                android:id="@+id/legend_swatch_1"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/legend_swatch_shape"
                                android:backgroundTint="#FF0000" />

                            <TextView
                                android:id="@+id/legend_text_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Visit"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/legend_row_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp"
                            android:paddingEnd="4dp">

                            <View
                                android:id="@+id/legend_swatch_2"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/legend_swatch_shape"
                                android:backgroundTint="#008000" />

                            <TextView
                                android:id="@+id/legend_text_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trip"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/legend_line_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/legend_row_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp"
                            android:paddingEnd="10dp"
                            android:visibility="gone">

                            <View
                                android:id="@+id/legend_swatch_3"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/legend_swatch_shape"
                                android:backgroundTint="#808080" />

                            <TextView
                                android:id="@+id/legend_text_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vehicle"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/legend_row_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp"
                            android:paddingEnd="4dp"
                            android:visibility="gone">

                            <View
                                android:id="@+id/legend_swatch_4"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/legend_swatch_shape"
                                android:backgroundTint="#808080" />

                            <TextView
                                android:id="@+id/legend_text_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bicycle"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/legend_line_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/legend_row_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp"
                            android:paddingEnd="4dp"
                            android:visibility="gone">

                            <View
                                android:id="@+id/legend_swatch_5"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/legend_swatch_shape"
                                android:backgroundTint="#E53935" />

                            <TextView
                                android:id="@+id/legend_text_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lost signal"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/recording_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/start_stop_recording"
            android:minHeight="48dp"
            android:text="@string/record"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:translationY="-40dp"
            app:backgroundTint="@color/fab_idle"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_start"
            app:iconSize="18dp"
            app:iconTint="@android:color/white"
            app:layout_anchor="@id/bottom_sheet_container"
            app:layout_anchorGravity="top|end" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/timeline_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        app:headerLayout="@layout/nav_header_timeline"
        app:menu="@menu/timeline_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>